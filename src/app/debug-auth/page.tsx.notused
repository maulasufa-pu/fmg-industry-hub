// src/app/debug-auth/page.tsx
"use client";
/* eslint-disable @typescript-eslint/no-explicit-any */

import React, { useEffect, useState } from "react";
import { debugUserRole } from "../../utils/debug-auth";

export default function DebugAuthPage() {
  const [debugInfo, setDebugInfo] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const runDebug = async () => {
      const result = await debugUserRole();
      setDebugInfo(result);
      setLoading(false);
    };
    
    runDebug();
  }, []);

  if (loading) {
    return (
      <div className="p-6">
        <h1 className="text-2xl font-bold mb-4">Debug Authentication</h1>
        <p>Loading...</p>
      </div>
    );
  }

  return (
    <div className="p-6 max-w-4xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">Debug Authentication Status</h1>
      
      <div className="bg-gray-50 p-4 rounded-lg">
        <h2 className="text-lg font-semibold mb-3">Debug Result:</h2>
        <pre className="text-sm bg-white p-3 rounded border overflow-auto">
          {JSON.stringify(debugInfo, null, 2)}
        </pre>
      </div>
      
      {debugInfo?.success && (
        <div className="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="bg-blue-50 p-4 rounded-lg">
            <h3 className="font-semibold text-blue-800">User Info</h3>
            <p><strong>ID:</strong> {debugInfo.userId}</p>
            <p><strong>Email:</strong> {debugInfo.userEmail}</p>
          </div>
          
          <div className="bg-green-50 p-4 rounded-lg">
            <h3 className="font-semibold text-green-800">Role Info</h3>
            <p><strong>Role:</strong> {debugInfo.role || "null"}</p>
            <p><strong>Can Access Admin:</strong> {debugInfo.canAccessAdmin ? "✅ YES" : "❌ NO"}</p>
          </div>
          
          {debugInfo.profile && (
            <div className="bg-purple-50 p-4 rounded-lg md:col-span-2">
              <h3 className="font-semibold text-purple-800">Full Profile</h3>
              <pre className="text-xs mt-2 bg-white p-2 rounded overflow-auto">
                {JSON.stringify(debugInfo.profile, null, 2)}
              </pre>
            </div>
          )}
        </div>
      )}
      
      {debugInfo?.error && (
        <div className="mt-6 bg-red-50 p-4 rounded-lg">
          <h3 className="font-semibold text-red-800">Error</h3>
          <p><strong>Message:</strong> {debugInfo.error}</p>
          {debugInfo.details && (
            <pre className="text-xs mt-2 bg-white p-2 rounded overflow-auto">
              {JSON.stringify(debugInfo.details, null, 2)}
            </pre>
          )}
        </div>
      )}

      <div className="mt-6 bg-yellow-50 p-4 rounded-lg">
        <h3 className="font-semibold text-yellow-800">Navigation Tests</h3>
        <div className="mt-2 space-y-2">
          <a href="/admin/users" className="block text-blue-600 hover:underline">
            → Try accessing /admin/users
          </a>
          <a href="/client/dashboard" className="block text-blue-600 hover:underline">
            → Try accessing /client/dashboard
          </a>
          <a href="/admin/dashboard" className="block text-blue-600 hover:underline">
            → Try accessing /admin/dashboard
          </a>
        </div>
      </div>

      <div className="mt-6">
        <button
          onClick={() => {
            setLoading(true);
            const runDebug = async () => {
              const result = await debugUserRole();
              setDebugInfo(result);
              setLoading(false);
            };
            runDebug();
          }}
          className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
        >
          🔄 Refresh Debug Info
        </button>
      </div>
    </div>
  );
}
